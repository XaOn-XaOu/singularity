# Local development settings. Copy this file to .env (git-ignored) in the
# same folder. The values match docker-compose.yml: start the services with
# `pnpm services:up`. claude/ uses Postgres on 5433 and Mailpit's default
# ports + 1, so it can run next to mine/.

# Postgres
DATABASE_URL=postgres://singularity:singularity@localhost:5433/singularity
TEST_DATABASE_URL=postgres://singularity:singularity@localhost:5433/singularity_test

# Mailpit catches every email the apps send; nothing leaves your machine.
SMTP_HOST=localhost
SMTP_PORT=1026
MAILPIT_URL=http://localhost:8026
